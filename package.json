{
  "name": "splitllm",
  "version": "2.0.0",
  "private": true,
  "description": "Router-based CLI with a self-learning module graph. Deterministic routing, inspectable confidence.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "splitllm": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "serve": "node --experimental-strip-types src/server/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
